        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(conduit_llm_latency_seconds_bucket{cache=\"miss\"}[5m])))",
          "legendFormat": "p99 miss",
          "refId": "C"
        }
      ],
      "title": "Upstream latency (cache miss)",
      "type": "timeseries"
    },
    {
