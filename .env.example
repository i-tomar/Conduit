# Local demo defaults. Do not use these values on a shared network.
CONDUIT_DATABASE_URL=sqlite+aiosqlite:///./conduit.db
CONDUIT_REDIS_URL=redis://localhost:6379/0
CONDUIT_CONFIG_PATH=config/gateway.yaml
CONDUIT_ADMIN_TOKEN=dev-admin-token
CONDUIT_DEV_API_KEY=cdt_live_dev_local_key
CONDUIT_KEY_PEPPER=replace-with-a-long-random-string
CONDUIT_ALLOW_FAULT_INJECTION=false
# CONDUIT_SEMANTIC_CACHE=true
CONDUIT_OTEL_ENABLED=true
CONDUIT_OTLP_ENDPOINT=
CONDUIT_LOG_LEVEL=INFO
CONDUIT_LOG_PROMPTS=false

# Provider credentials. Leave unset to skip that provider.
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
